# ============================ Next.js (Vercel → Environment Variables) ============================
NEXT_PUBLIC_SITE_URL=https://www.winex.ro

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=
# Segreto condiviso Next.js ↔ Convex. Stesso valore di INGEST_SECRET in Convex.
# Genera: openssl rand -hex 32
CONVEX_INGEST_SECRET=
# (opzionale) sale per l'ID visitatore anonimo; se assente usa CONVEX_INGEST_SECRET
ANALYTICS_SALT=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM="Winex <no-reply@winex.ro>"
# Casella che riceve i messaggi dal modulo contatti (modificabile anche da admin → Notificări)
CONTACT_TO_EMAIL=
# (opzionale) Audience Resend per la newsletter
RESEND_AUDIENCE_ID=
# Segreto del webhook Resend (statistiche campagne, bounce/reclami): "whsec_…"
RESEND_WEBHOOK_SECRET=

# --- Notifiche push admin (genera: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@winex.ro

# --- OneSpec ---
NEXT_PUBLIC_ONESPEC_URL=

# ============================ Convex (dashboard → Settings → Environment Variables) ============================
# Si impostano con:  npx convex env set NOME valore     (NON vanno su Vercel)
#
#   ADMIN_EMAILS      stefan@…,altro@…          email autorizzate ad entrare nell'admin
#   INGEST_SECRET     (stesso valore di CONVEX_INGEST_SECRET)
#   AUTH_RESEND_KEY   chiave Resend per i codici di login
#   RESEND_API_KEY    chiave Resend per le campagne
#   RESEND_FROM       "Winex <no-reply@winex.ro>"
#   SITE_URL          https://www.winex.ro
#   JWT_PRIVATE_KEY / JWKS   generati da:  npx @convex-dev/auth
