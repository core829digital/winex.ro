# --- Sito ---
NEXT_PUBLIC_SITE_URL=https://www.winex.ro

# --- Convex (https://dashboard.convex.dev) ---
NEXT_PUBLIC_CONVEX_URL=
# Segreto condiviso tra Next.js e Convex (stesso valore in entrambi).
# Genera: openssl rand -hex 32  — in Convex: npx convex env set INGEST_SECRET <valore>
CONVEX_INGEST_SECRET=

# --- Resend (https://resend.com) ---
RESEND_API_KEY=
RESEND_FROM="Winex <no-reply@winex.ro>"
# Casella che riceve i messaggi dal modulo contatti
CONTACT_TO_EMAIL=
# (opzionale) Audience Resend per la newsletter
RESEND_AUDIENCE_ID=

# --- OneSpec (https://onespec.eu) ---
# URL del configuratore da incorporare (fornito da OneSpec)
NEXT_PUBLIC_ONESPEC_URL=
